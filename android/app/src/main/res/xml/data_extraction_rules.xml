<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Some Android 12+ OEM migrations ignore allowBackup=false for D2D.
         Explicitly exclude every app-private data domain because it can
         contain WebView and imported cookies. Downloaded media is stored in
         the system media library and is not affected by this rule. -->
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
